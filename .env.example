VITE_API_BASE_URL=http://localhost:8001/api/v1
VITE_SIGNUP_URL=

# Optional demo-only test login. VITE_* values are public in browser bundles.
# Enable only for disposable accounts on an exact allowlisted development host.
VITE_DEPLOYMENT_ENV=local-development
VITE_ENABLE_TEST_AUTH=false
VITE_TEST_AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
VITE_TEST_ADMIN_LOGIN=
VITE_TEST_ADMIN_PASSWORD=
VITE_TEST_STUDENT_LOGIN=
VITE_TEST_STUDENT_PASSWORD=
